# Пример настроек окружения Investing Demo.
# Скопируйте файл в .env и при необходимости измените значения.
# .env не коммитится в git.

# --- Core Django ---
# Секретный ключ проекта. В production обязательно замените.
SECRET_KEY=django-insecure-dev-only-key-change-me
# on/off
DJANGO_DEBUG=on
# Домены через запятую
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Файл журнала
LOG_FILE=app.logs

# --- База данных ---
# sqlite (умолчание) — локальный запуск без Docker; postgres — как в исходном проекте.
DATABASE=sqlite
# При DATABASE=postgres используются эти переменные:
# DATABASE=postgres
# DB_NAME=investing
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- Часовой пояс ---
TIME_ZONE=UTC

# --- Tinkoff Invest API ---
# Реальный токен пользователя Tinkoff (инвестиций). Пусто — приложение работает,
# но графики и обновление цен явно сообщают об отсутствии токена.
TINKOFF_TOKEN=
TINKOFF_APP_NAME=investing-demo
# Ограничение времени внешних запросов к Tinkoff API, сек
TINKOFF_TIMEOUT=30

# --- История цен (этап 1 задания №4, см. FEATURES.md) ---
# Источник накопления цен: tinkoff (реальный API, нужен токен выше) или
# demo (ЯВНО включаемый демонстрационный режим с синтетическими ценами;
# такие данные помечаются источником и показываются как демонстрационные).
PRICE_SOURCE=tinkoff
# Интервал локального коллектора collect_prices, сек (Redis не обязателен)
PRICE_COLLECT_INTERVAL=10

# --- Celery ---
# Брокер задач (Redis). Docker не обязателен: Redis можно поднять локально.
# Без Redis работают веб-интерфейс и REST API, но beat/worker не смогут
# поставить/выполнить фоновую задачу — это будет явная ошибка соединения.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# В тестах цель Celery можно выполнять синхронно:
# CELERY_TASK_ALWAYS_EAGER=on
CELERY_TASK_TRACK_STARTED=on
CELERY_TASK_TIME_LIMIT=1800
