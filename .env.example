DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-key-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite is the local default; set to postgresql to use the variables below.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Leave empty to disable market data requests.
TINKOFF_TOKEN=
TINKOFF_RPC_TIMEOUT_SECONDS=10
PRICE_DATA_MODE=live
PRICE_COLLECTION_INTERVAL_SECONDS=300
STRATEGY_MAX_OBSERVATION_AGE_SECONDS=300

# Redis is required only for Celery workers and Beat, not the local collector.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
